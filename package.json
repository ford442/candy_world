{
    "name": "candy_world",
    "version": "1.0.0",
    "description": "A 3D world of rudimentary, but sharp graphically nature - featuring smooth, glossy shapes in a pastel candy-colored landscape.",
    "type": "module",
    "scripts": {
        "dev": "bash dev.sh",
        "dev:fast": "vite --open '?boot=instant&graphics=low&map=small'",
        "preview": "vite preview",
        "build:wasm": "asc assembly/index.ts --outFile src/wasm/candy_physics.wasm --textFile src/wasm/candy_physics.wat --sourceMap --shrinkLevel 0 --optimize --converge --optimizeLevel 3 --enable simd --enable bulk-memory --initialMemory 5 --maximumMemory 256 --target wasm-gc --enable reference-types --enable gc --exportRuntime --bindings esm",
        "build:emcc": "bash emscripten/build.sh",
        "build:ci": "npm run build:wasm && vite build",
        "optimize": "cd tools/build-optimizer && npm run optimize",
        "optimize:assets": "cd tools/build-optimizer && npm run optimize:assets",
        "optimize:split": "cd tools/build-optimizer && npm run optimize:split",
        "analyze": "cd tools/build-optimizer && npm run analyze",
        "analyze:bundle": "cd tools/build-optimizer && npm run analyze:bundle",
        "analyze:treeshake": "cd tools/build-optimizer && npm run analyze:treeshake",
        "analyze:compress": "cd tools/build-optimizer && npm run analyze:compress",
        "budget": "cd tools/build-optimizer && npm run budget",
        "budget:check": "cd tools/build-optimizer && npm run budget:check",
        "budget:batchers": "cd tools/build-optimizer && npm run budget:batchers",
        "build": "npm run build:wasm && npm run build:emcc && vite build",
        "build:optimized": "npm run build:wasm && npm run build:emcc && npm run optimize && vite build",
        "test": "node --experimental-detect-module tests/smoke-runner.mjs",
        "test:wasm": "node tests/wasm.mjs",
        "test:parity": "node tests/parity.mjs",
        "test:awakened": "node tests/awakened-persistence.mjs",
        "test:ground": "node tests/ground-system.test.mjs",
        "test:ground-unified": "node tests/ground-unified-parity.mjs",
        "test:player-spawn": "tsx tests/player-spawn.test.mjs",
        "test:character": "tsx tests/character-controller.test.mjs",
        "test:sky-islands": "node tests/sky-islands-traversal.test.mjs",
        "test:presence": "tsx tests/presence-protocol.test.mjs",
        "test:sugar-caves": "tsx tests/sugar-caves-traversal.test.mjs",
        "test:foliage-interact": "node tests/foliage-interact.test.mjs",
        "test:cookbook-presets": "node scripts/check-cookbook-presets.mjs",
        "test:spawn-tracker": "node tests/spawn-tracker.test.mjs",
        "test:world-health": "node tests/world-health.test.mjs",
        "test:wasm-loader": "node tests/wasm-loader-reliability.mjs",
        "test:startup": "node tests/startup-bootstrap.mjs",
        "test:capabilities": "tsx tests/startup-capabilities.test.mjs",
        "test:world-extent": "tsx tests/world-extent.test.mjs",
        "test:cascades": "tsx tests/shadow-cascades.test.mjs",
        "test:lights": "tsx tests/local-lights.test.mjs",
        "test:clustered": "tsx tests/clustered-lights.test.mjs",
        "test:gi": "tsx tests/irradiance-probes.test.mjs",
        "test:postfx": "tsx tests/postfx.test.mjs",
        "test:boot": "npm run test",
        "test:world": "BOOT_PATH=explore npm run test",
        "test:boot:timing": "node tests/boot-timing.mjs",
        "test:atmosphere": "node tests/atmosphere-reactivity.test.mjs",
        "test:explore": "node tests/explore-camera.test.mjs",
        "test:batcher-lod": "node tests/batcher-lod.test.mjs",
        "test:integration": "npm run build:wasm && npm run test:wasm && npm run test:parity && npm run test:cookbook-presets && npm run test:spawn-tracker && npm run test:player-spawn && npm run test:character && npm run test:world-health && npm run test:presence && npm run test:sugar-caves && npm run test:capabilities && npm run test:world-extent && npm run test:lights && npm run test:clustered && npm run test:gi && npm run test:postfx && npm run test",
        "test:smoke:full": "FULL_BOOT=1 npm run test",
        "test:smoke:fast": "FULL_BOOT=fast npm run test",
        "test:smoke:webgl": "RENDERER=webgl npm run test",
        "test:visual": "cd tools/visual-regression && pnpm run test:visual",
        "test:visual:typecheck": "cd tools/visual-regression && pnpm run typecheck",
        "verify:chunk-index": "node scripts/verify-chunk-index.mjs",
        "verify:emcc": "node verification/verify_emcc_exports.js",
        "verify:emcc:manifest": "node scripts/check-emcc-manifest.mjs",
        "generate:map": "tsx tools/map-generator/cli.ts",
        "generate:chunk-index": "tsx tools/map-generator/build-chunk-index.ts",
        "export:map": "tsx tools/map-generator/export-current-world.ts",
        "release:tag": "node scripts/make-release.mjs",
        "release": "npm run build && node scripts/make-release.mjs",
        "typecheck": "node scripts/tsc-ratchet.mjs",
        "test:generative": "node tests/generative-sequencer.mjs",
        "test:photo-mode": "node tests/photo-mode.test.mjs",
        "lint": "node scripts/eslint-ratchet.mjs",
        "lint:ratchet": "node scripts/eslint-ratchet.mjs",
        "lint:raw": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "simple-git-hooks"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.110.5",
        "madge": "^8.0.0",
        "three": "^0.171.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.60.0",
        "@types/three": "^0.171.0",
        "assemblyscript": "^0.27.37",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "playwright": "^1.60.0",
        "prettier": "^3.9.5",
        "simple-git-hooks": "^2.13.1",
        "tsx": "^4.7.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^5.0.0",
        "vite-plugin-top-level-await": "^1.6.0",
        "vite-plugin-wasm": "^3.5.0"
    },
    "simple-git-hooks": {
        "pre-commit": "node scripts/prettier-staged.mjs"
    },
    "pnpm": {
        "overrides": {
            "@swc/core": "1.15.47",
            "@swc/wasm": "1.15.47"
        }
    },
    "overrides": {
        "@swc/core": "1.15.47",
        "@swc/wasm": "1.15.47"
    }
}